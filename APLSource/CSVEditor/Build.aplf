 Build←{
     d←A.NewDocument''
     b←A.GetBody d

     h←b A.New'header'
     h.Document←d
     d.AppStyle←CSS 0

     ⍝ hm←h A.Menu.NewHamburgerMenu'BuildMenu'
     ⍝ mb←h A.Menu.NewMenuBar'BuildMenu'

     hm←h API.Menu.NewHamburgerMenu A.FQP'BuildMenu'
     mb←h API.Menu.NewMenuBar A.FQP'BuildMenu'




     tb←h BuildToolbar 0
     ⍝ *******************
     m←b A.New'main'
     ed←m A.TextInput.New'Text Edit' 'SomeText'

     t←m A.Tabs.New''
     t.OnActivate←A.FQP'OnActivate'
     t.id←'MainTabControl'
     ⍝ f←b A.New'footer'
     ⍝ l1←f A.New'h2'
     ⍝ l1.id←'FullFileName'
     ⍝ l2←f A.New'h2'
     ⍝ l2.id←'FileDimensions'
     d.FileSettings←()
     d.BrowseFolder←''
     d.OnKeyDown←A.FQP'OnKeyDown'
     d
 }
