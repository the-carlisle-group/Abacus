 OnWindowBlur←{
     ⍝ Application Window has lost focus
     ⍝ Close any and all popovers, (Menus, AutoComplete)
     ⍝ ... and Selects
     d←⍵.Document
     d.HasFocus←0
     e←⊃⌽(GetBody d),d GetElementsByTag'dialog'
     _←e ExecuteOnElement d.ClickToFocusOnly/'inert = true'
     d.IgnoreSelectOnFocus←1
     e←d GetElementsByClass'menu'
     _←{0=≢⍵:0 ⋄ DeleteElement¨⍵}e
     e←d GetElementsWhere'popover' 'auto'
     _←{0=≢⍵:0 ⋄ ⍵ ExecuteOnElement¨⊂'hidePopover()'}e
     e←d GetElementsByTag'select'
     0
 }
