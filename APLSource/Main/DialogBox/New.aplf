 New←{
     ⍺←0
     d←A.InitComp(A.New'dialog')⎕NS(
         'Title' ''
         'Subtitle' ''
         'MainContent'⍬
         'Buttons'('OK' 'Cancel')
         'Icons' 'none'
         'OnClick' ''
         'OnCancel' ''
     )A.Default ⍵
     d.Document←⍺
     d.Buttons←,⊆d.Buttons
     d.OnClick←(≢d.Buttons)⍴⊆d.OnClick
     d.Icons←(≢d.Buttons)⍴⊆d.Icons
     d.Onkeydown←A.FQP'OnKeyDown'
     h←d A.New'header'(A.New¨'h1' 'h2'{⍺ ⍵}¨d.Title d.Subtitle)
     m←d A.New'section'd.MainContent
     b←d.Buttons A.Button.New¨d.Buttons{⍺ ⍵}¨d.Icons
     b.Onclick←⊂A.FQP'OnClick'
     b.Name←d.Buttons
     f←d A.New'footer'b
     d.Onclose←A.FQP'OnClose'
     d
 }
