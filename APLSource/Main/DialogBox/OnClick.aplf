 OnClick←{
     b←⍵.CurrentTarget
     d←b A.GetNearest'dialog'
     _←d A.SetHidden 1
     i←b.Parent.Content⍳b
     f←i⊃d.OnClick
     e←()
     e.Event←'Click'
     e.Component←d
     e.Button←b
     e.ButtonCaption←i⊃d.Buttons
     _←d A.SetHidden 1
     r←f A.FireAbacusEvent e
     r≡0:A.DeleteElement d
     d A.SetHidden 0
 }
