 CSS←{
     Rule←##.NewRule
     ⍝ ************************
     s←Rule'.RadioGroup'
     s.display←'inline-flex'
     s.flex_direction←'column'
     s.align_items←'flex-start'
     s.gap←'.5em'
     s.font_family←'Arial'
     s.padding←'1rem'
     s.border←'var(--border)'
     s.border_radius←'var(--border-radius)'

     ⍝ s.margin←'1em'  ?

     ⍝ ****************************
     r←s Rule'div'
     r.display←'flex'
     r.align_items←'center'

     ⍝ *******************************
     r←s Rule'input'
     r.width←'1.5rem'
     r.height←'1.5rem'
     r.appearance←'none'
     r.border_radius←'50%'
     r.border←'var(--border)'
     r.position←'relative'
     ⍝ ***************************
     r←s Rule'input:focus'
     r.border←'var(--border-focused)'

     ⍝ ************************
     r←s Rule'input:checked::before'
     r.content←'""'
     r.width←'1rem'
     r.height←'1rem'
     r.background_color←'white'
     r.border_radius←'50%'
     r.position←'absolute'
     r.top←'50%'
     r.left←'50%'
     r.transform←'translate(-50%, -50%)'




     ⍝ ******************************
     r←s Rule'>div'
     r.display←'flex'
     r.gap←'.5em'
     ⍝ ***************************
     ##.UnNestCSS s
 }
