 New←{
     ⍺←0
     w←(
         'Title' 'Confirmation'
         'Message' 'Continue?'
         'Buttons'('Yes' 'No')
         '_min_width' '30rem'
         '_max_width' '40rem'
     )A.Default ⍵
     p←()
     p.Title←w.Title
     p.Buttons←w.Buttons
     p.MainContent←A.New¨{'p'⍵}¨⊆w.Message
     p.OnClick←A.FQP'OnSelect'
     p.OnCancel←A.FQP'OnClose'
     d←⍺ A.DialogBox.New p
     f←d A.GetElementByTag'footer'
     b←f A.GetElementsByTag'button'
     b.Unqueued←⊂'click'
     d.Unqueued←'close'
     d ⎕NS w⊣w.⎕EX d.⎕NL 2
 }
