 New←{
     ⍺←0
     w←(
         'Title' ''
         'Label' ''
         'Value' ''
         'OnOK' ''
         'OnCancel' ''
         'Options' ''
         'Type' 'Text' ⍝ Text Date File Number
         '_width' '30rem'
     )A.Default ⍵
     c←A⍎w.Type,'Input'
     PromptBox←c.New w.Label w.Value,(w.Type≡'Text')/⊂w.Options
     p←()
     p.Title←w.Title
     p.MainContent←PromptBox
     p.OnClick←A.FQP¨'OnOK' 'OnCancel'
     p.OnCancel←A.FQP'OnCancel'
     d←⍺ A.DialogBox.New p
     d.OnCancelPromptBox←w.OnCancel
     d ⎕NS w⊣w.⎕EX d.⎕NL 2
 }
