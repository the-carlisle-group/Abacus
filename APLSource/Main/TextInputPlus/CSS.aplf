 CSS←{
     Rule←A.NewRule
     ⍝ ************************
     s←Rule'.TextInputPlus'

     r←s Rule'&:focus-within'
     r.border←'var(--border-focused)'

     s.display←'flex'
     s.gap←'.5rem'
     s.border←'2px solid var(--background-color)'
     s.border_radius←'var(--border-radius)'
     s.anchor_name←'--text-input-plus'
     s.anchor_scope←'all'
     s.padding←'.5em'
     s.background_color←'hsl(235, 14%, 20%)'
     ⍝ *************************************
     r←s Rule'dialog'
     r.position←'absolute'
     r.position_anchor←'--text-input-plus'
     r.position_area←'bottom span-right'
     r.color←'inherit'
     r.background_color←'inherit'
     r.border_radius←'var(--border-radius)'
     r.border←'var(--border-focused)'
     ⍝ *************************************
     r←s Rule'dialog>textarea'
     r.color←'inherit'
     r.background_color←'inherit'
     r.border←'none'
     r.resize←'none'
     r.font_family←'var(--user-input-font-family)'
     r.font_size←'1rem'
     r.padding←'.5rem'
     r.width←'40rem'
     ⍝ All buttons
     r←s Rule'button'
     r.border←'none'
     ⍝ ************************************
     r←s Rule'button>span'
     r.white_space←'nowrap'
     r.flex←'1'
     r.font_family←'var(--user-input-font-family)'
     r.font_size←'1.2rem'
     r.color←'white'
     r.border←'none'
     r.background_color←'hsl(235, 14%, 20%)'
     r.text_align←'left'
     r.display←'block'
     ⍝ **************************************
     r←s Rule'button>label'
     r.font_family←'Arial'
     r.font_size←'1.2rem'
     r.color←'var(--accent-color-1)'
     r.font_weight←'bold'
     ⍝ Buttons
     r←s Rule'button:focus'
     r.outline←'none'
     r.border←'none'
     ⍝ Buttons
     ⍝ r←s Rule'button'
     ⍝ r.padding←'.2rem'
     ⍝ r.min_width←'0'


     ⍝ r.border_radius←'var(--border-radius)'
     ⍝ r←s Rule'>button:hover'
     ⍝ r.background_color←'gray'
     ⍝
     s

 }
