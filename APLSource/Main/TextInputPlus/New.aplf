 New←{
     ⍺←0
     (p n)←A.DefaultParentAndName ⍺
     d←A.InitComp(p A.New'div')⎕NS(
         'Value'('' '' '')  ⍝ Actual Val, Display Val, Label Val
         'Placeholder' ''
         'Options' ''
         'History' ''
         'OnEnter' ''
         'OnClear' ''
         'Buttons' '' ⍝ In addition to x for clear (these are icon names)
         'OnClick' '' ⍝ For each button
         'HideOnClear' 0
         'Tip' ''
         'Rows' 5
     )A.Default ⍵
     d.Name←n
     d.HideOnClear←1,⍨d.HideOnClear⍴⍨≢d.Buttons
     ⍝ **********************************
     ⍝ Hidden Text Area with actual value
     ⍝ **********************************
     db←d A.New'dialog'
     db.closedby←'any'
     ta←db A.New'textarea'(0⊃d.Value)
     ta.rows←d.Rows
     d.Oninput←A.FQP'OnInput'
     ta.History←d.History
     ta.HistoryIndex←⍬
     ta.OnEnter←A.FQP'OnEnter'  ⍝ used by autocomplete!
     _←ta A.AutoComplete.Init d.Options
     ⍝ *************************************
     ⍝ Main Single button to contain a span and a label
     ⍝ *************************************
     mb←d A.New'button'
     mb.ToolTip←d.Tip
     mb._display←'flex'
     mb._border←'none'
     ⍝ mb._padding←'5px'
     mb._flex←'1'
     mb._align_items←'center'
     mb.Onclick←A.FQP'OnClick'
     ⍝ *************************************
     ⍝ A span for formatted, truncated value
     ⍝ *************************************
     s←mb A.New'span'((''≡(0⊃d.Value))⊃(1⊃d.Value)d.Placeholder)
     ⍝ *************************************
     ⍝ A label for additional info
     ⍝ *************************************
     l←mb A.New'label'(2⊃d.Value)
     ⍝ *************************
     ⍝ Other Buttons
     ⍝ **************************
     b←d{⍺ ##.Button.New('Icon'(0⊃⍵))('OnClick'(1⊃⍵))}¨↓⍉↑(d.Buttons,⊂'CircleX')(d.OnClick,⊂A.FQP'OnClear')
     b._min_width←'0'
     b._padding←'0'


     b.class←b.class,¨'' ' hidden'[d.HideOnClear∧''≡0⊃d.Value]
     b.tabindex←⊂'-1'
     d
 }
