// Create a single ResizeObserver (efficient for multiple elements)
const resizeObserver = new ResizeObserver(entries => {

  // Collect the elements across calls: each observe() reports separately, and so
  // does each element resizing on its own, but the timeout below fires only once
  const pending = resizeObserver.pending || (resizeObserver.pending = new Set());
  for (const entry of entries) {
       pending.add(entry.target);
  }

if (resizeObserver.timeoutId) {
    clearTimeout(resizeObserver.timeoutId);
  }
   
  
  // Set new timeout (e.g., 100–200ms is good for most UI work)
  resizeObserver.timeoutId = setTimeout(() => {
  // This runs only after 150ms of no new resize events

  for (const e of pending) {
       const b = {Event: "Resize",
                  TargetId: e.id, 
                  CurrentTargetId: e.id, 
                  Height: e.clientHeight,
                  Width: e.clientWidth}; 
       const m = JSON.stringify(b); 
       ws.send (m)
  }
    // Clean up
    pending.clear();
    resizeObserver.timeoutId = null;
  }, 150);
});


const pdKeys = ['F1','F2','F3','F4','F5','F6','F7','F8','F9','F10','F11','F12']; 

   
   document.addEventListener('keydown', function(event) {
    
    if (pdKeys.includes(event.key)) {
        event.preventDefault(); 
    }
});







function sendAPLRequest(e){
      // A modifier key on its own means nothing to APL, and holding it down - as
      // for a Ctrl+click - repeats its keydown many times a second. Each would be
      // a round trip to APL, queued ahead of whatever the user does next.
      if (e.type==="keydown"&&["Control","Shift","Alt","AltGraph","Meta","CapsLock","NumLock","ScrollLock"].includes(e.key)){
                return;
       }
      // const ce=[e.currentTarget.className,e.currentTarget.tagName,e.type,e.key].join();
      const ce=[e.target.tagName,e.type,e.key].join();
      const pd=PreventDefaultList.includes(ce);
      // alert (ce)
      if (pd){
                e.preventDefault();
       }     
      
      const r = e.target.getBoundingClientRect();
      const q = e.currentTarget.getBoundingClientRect();
      const s = window.getComputedStyle(e.target);
      const b = {
                Event: e.type,
                Value: e.target.value,
                Name: e.target.name,
                TargetTag: e.target.tagName,
                CurrentTargetTag: e.currentTarget.tagName, 
                TargetId: e.target.id, 
                CurrentTargetId: e.currentTarget.id, 
                Key: e.key, 
                Code: e.code,
                MetaKey: e.metaKey,
                CtrlKey: e.ctrlKey,
                AltKey: e.altKey,
                ShiftKey: e.shiftKey,
                MouseButton: e.button,
                MouseButtons: e.buttons,
                SelectionStart: e.target.selectionStart, 
                NewState: e.newState,
                FontSize: s['font-size'],
                FontFamily: s['font-family'],
                Font: s['font'],
                Padding: s['padding'],
                MouseViewportPosition: [e.clientY,e.clientX],
                MouseTargetPosition: [e.offsetY,e.offsetX],
                CurrentTargetPosition: [q.top,q.left],
                CurrentTargetSize: [q.height,q.width],
                TargetPosition: [r.top,r.left],
                TargetSize: [r.height,r.width]
                };
      const m = JSON.stringify(b); 
      ws.send (m)
}

// A click on a window that is not at the front activates it, and Windows
// then passes the click on to whatever sits under the mouse, which can set
// off a button or a grid cell nobody meant to touch. Word and Excel swallow
// that click, and so does Abacus: while the window is not at the front, and
// for a short while after it comes back, a press is taken away from the
// element under the mouse, and the click that follows it goes the same way,
// however long the button is held. The window still comes to the front,
// because that happens outside the browser. clickGuardPeriod is that while,
// in milliseconds; 0 switches the guard off, see the HTMLDocument method
// SetClickGuard. Only the mouse is guarded, and of it only what the user
// does: a click the keyboard makes, where detail is 0, is let through, a
// keystroke not being a way to bring a window to the front, and so is an
// event dispatched by JavaScript, as the test suite does to simulate a click.
var clickGuardPeriod=250;
var clickGuardUntil=0;
var clickGuardPress=false;
function clickGuard(e){
      if (!e.isTrusted||!clickGuardPeriod||!e.detail) return;
      const eat=clickGuardPress||Date.now()<clickGuardUntil;
      clickGuardPress=eat&&e.type==="mousedown";
      if (!eat) return;
      e.stopPropagation();
      e.preventDefault();
}
window.addEventListener("blur",()=>{clickGuardUntil=Infinity;clickGuardPress=false;});
window.addEventListener("focus",()=>{clickGuardUntil=Date.now()+clickGuardPeriod;clickGuardPress=false;});
for (const t of ["mousedown","click","dblclick"]) window.addEventListener(t,clickGuard,true);
