 New←{
     ⍺←0
     (p n)←A.DefaultParentAndName ⍺
     d←A.InitComp(p A.New'div')⎕NS(
         'Value' ''
         'Placeholder' ''
         'Options' ''
         'History' ''
         'OnEnter' ''
         'OnChange' ''    ⍝ For now
         'OnClear' ''
         'Buttons' ''
         'OnClick' ''
         'HideOnClear' 0
     )A.Default ⍵
     d.Name←n
     d.HideOnClear←1,⍨d.HideOnClear⍴⍨≢d.Buttons
     i←d A.New'input'
     i.placeholder←d.Placeholder
     i.History←d.History
     i.HistoryIndex←⍬
     _←i A.AutoComplete.Init d.Options
     _←d InitValue d.Value
     d.Oninput←A.FQP'OnInput'
     d.Onchange←A.FQP'OnChange'
     ⍝ ********************
     ⍝ Add Buttons
     ⍝ ********************
     b←d{⍺ ##.Button.New('Icon'(0⊃⍵))('OnClick'(1⊃⍵))}¨↓⍉↑(d.Buttons,⊂'CircleX')(d.OnClick,⊂A.FQP'OnClear')
     b._min_width←'0'
     b._padding←'0'
     b.class←b.class,¨'' ' hidden'[d.HideOnClear∧''≡d.Value]
     b.tabindex←⊂'-1'
     d
 }
