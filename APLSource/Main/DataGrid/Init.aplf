 Init←{
     ⍺←0
     g←⍵
     t←g.Table
     ⍺∧t.Init:1
     0=≢t.Columns:1
     t.Columns←DefaultColumnProperties t
     c←t.Columns
     r←(Align:'r' ⋄ Class:'r' ⋄ SortDirection:0 ⋄ Highlight:0)    ⍝ For row numbers
     t.RowNumberColumn←r
     a←r,c   ⍝ All columns, inlcuding row numbers
     _←g InitColumnMask t.ColumnMask
     _←g InitRowMask t.RowMask
     c.HeaderValues←↓↑,¨⊆¨c.HeaderValues  ⍝ V of V, same length
     t.HeaderRowCount←≢⊃c.HeaderValues
     r.HeaderValues←{⍵↑(⊆t.HeaderRowTitles),⍵⍴⊂''}t.HeaderRowCount
     t.HeaderReadOnly←{⍵↑t.HeaderReadOnly,⍵⍴1}t.HeaderRowCount
     ⍝ For now: Total header height....
     t.HeaderHeight←t.HeaderRowCount×3×t.FontSize ⍝ Number of header rows ...
     t.RowHeight←2×t.FontSize
     _←g ##.SetDynamicCSS DynamicCSS t
     t.DataSize←≢¨t.RowIndices t.ColumnIndices
     c.MaxLength←1⊃¨2↑¨⍴¨c.Value
     a.Width←t ComputeWidths t.Columns.Width
     t.FixedColumns←t.RowNumbers+t.FreezeColumns
     t.WindowIndex⌈←0,t.FreezeColumns
     t.ActiveCell⌊←t.DataSize-1   ⍝  'ActiveCell'(0 0-0=t.DataSize)
     t.Selection←2⍴⊂t.ActiveCell
     a.HeaderStyle←ComputeHeaderStyles a
     a.HeaderClass←ComputeHeaderClass a
     a.ColumnClass←(a.Class),¨' ',¨'a',¨a.Align
     t.WindowPadding←3 5
     t.class←t.LightWeight/'LightWeight'
     t.Init←1
     0
 }
