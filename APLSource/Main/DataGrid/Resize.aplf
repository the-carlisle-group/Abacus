 Resize←{
     ⎕←'Resize!'
     g←⍺
     t←g.Table
     0=≢t.Columns:NoColumns g
     0=1⊃t.DataSize:NoColumns g
     t.ActiveCell⌊←0⌈t.DataSize-1
     c←t.Columns[t.ColumnIndices]
     a←c,⍨t.RowNumbers/t.RowNumberColumn
     t.AvailableWidth←g.Width-+/t.FixedColumns↑a.Width
     t.ColumnsPerIndex←1⌈t.AvailableWidth ComputeColumnsPerIndex t.FixedColumns↓a.Width
     t.ScrollIntoViewIndex←ComputeScrollIntoViewIndex t.ColumnsPerIndex
     t.RowsToDisplay←⌊t.RowHeight÷⍨g.Height-t.HeaderHeight
     t.WindowSize←t.RowsToDisplay,(1⊃t.WindowIndex)⊃t.ColumnsPerIndex
     t.DataWidth←+/a.Width
     t.DataHeight←t.RowHeight×⊃t.DataSize
     t.MaxWindowIndex←0⌈t.DataSize-t.WindowSize[0],1++/∧\2</⌽t.ColumnsPerIndex
     t.WindowIndex⌊←t.MaxWindowIndex
     ∨/t.WindowSize<1:0
     t.TableCell←t ActiveCell2TableCell t.ActiveCell
     _←g ResizeScrollBars''
     _←BuildStructure t
     Refresh t
 }
