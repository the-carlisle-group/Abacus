 OnScrollBarMouseMove←{
     ⍵.MouseButtons≠1:0
     tr←⍵.CurrentTarget
     0=tr.⎕NC⊂'StartDragMousePosition':0   ⍝ no thumb-drag active (e.g. a page-click on the track) → ignore
     th←⍵.Target
     t←tr.Parent.Table
     n←⍵.MouseViewportPosition
     m←⍵.CurrentTargetPosition
     d←n-m+tr.StartDragMousePosition
     j←¯1⌈1⌊d÷tr.MaxTopLeft
     i←tr.StartDragWindowIndex
     n←t.MaxWindowIndex
     k←0⌈n⌊i+⌊n×j
     i[tr.Horz]←tr.Horz⊃k
     t.WindowIndex←i
     0⊣Refresh t
 }
