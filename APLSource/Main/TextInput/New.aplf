 New←{
     ⍺←0
     (p n)←A.DefaultParentAndName ⍺
     d←A.InitComp(p A.New'div')⎕NS(
         'Label' ''
         'Value' ''
         'Options' ''
         'PickerCaption' ''
         'OnPicker' ''
         'OnChange' ''
         'Disabled' 0
         'SelectOnFocus' 1
     )A.Default ⍵
     d.Name←n
     d.Oninput←A.FQP'OnInput'
     d.Onchange←A.FQP'OnChange'
     l←d A.New'label'd.Label
     l.for←A.GetId 0
     n←d A.New'div'
     i←n A.New'input'
     i.id←l.for
     _←i A.AutoComplete.Init d.Options
     _←d InitValue d.Value
     _←d InitSelectOnFocus d.SelectOnFocus
     0=≢d.OnPicker:d
     b←n A.New'button'd.PickerCaption
     b.Onclick←A.FQP'OnPicker'
     d
 }
